{
  "name": "llama-mcp-bridge",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Local MCP bridge: owns any MCP servers (stdio or Streamable HTTP) and injects their tools into any OpenAI-compatible llama-server request.",
  "scripts": {
    "start": "node src/server/index.ts",
    "mcp": "node scripts/mcp.mjs",
    "menu": "node scripts/menu.mjs",
    "dev": "node --watch src/server/index.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\""
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/node": "^24.8.1",
    "@types/ws": "^8.18.2",
    "svelte": "^5.39.9",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "dependencies": {
    "ws": "^8.23.0"
  }
}
